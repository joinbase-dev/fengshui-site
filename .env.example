# Production URL used for canonical links, sitemap and Open Graph.
# Falls back to Vercel's production URL when unset.
NEXT_PUBLIC_SITE_URL=

# Where consultation form submissions are POSTed as JSON (see lib/consultation/deliver.ts).
CONSULTATION_WEBHOOK_URL=

# Set to "true" to allow indexing when hosting outside Vercel production.
SITE_INDEXABLE=
