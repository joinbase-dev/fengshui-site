# The production domain, e.g. https://example.com (no trailing slash), used for
# canonical links, the sitemap, Open Graph and structured data. Set it in Vercel for
# Production and Preview. When unset, Vercel's production domain is used.
NEXT_PUBLIC_SITE_URL=

# Set to "true" to allow indexing when hosting outside Vercel production. On Vercel,
# only the Production environment is indexable; leave this unset there.
SITE_INDEXABLE=
